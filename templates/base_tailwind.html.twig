<!DOCTYPE html>
<html lang="fr" class="h-full bg-stone-50">
    <head>
        {% set canonical_url = url(app.request.attributes.get('_route'), app.request.attributes.get('_route_params')) %}

        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <meta name="description" content="{% block meta_description %}{% endblock %}" />
        <meta name="keywords" content="{% block meta_keywords %}{% endblock %}" />
        {% block noindex %}{% endblock %}
        {% block canonical %}<link rel="canonical" href="{{ canonical_url }}">{% endblock %}
        {% block openGraph %}
            <meta property="og:type" content="website" />
            <meta property="og:site_name" content="Chanbora Chhun Photographe" />
            <meta property="og:locale" content="fr_FR" />
            <meta property="og:url" content="{{ canonical_url }}" />
            <meta property="og:title" content="{{ block('title') }}" />
            <meta property="og:description" content="{{ block('meta_description') }}" />
            <meta property="og:image" content="{% block og_image %}{{ absolute_url(asset('build/app/images/homepage/photographe.jpg')) }}{% endblock %}" />
            <meta name="twitter:card" content="summary_large_image" />
            <meta name="twitter:title" content="{{ block('title') }}" />
            <meta name="twitter:description" content="{{ block('meta_description') }}" />
            <meta name="twitter:image" content="{{ block('og_image') }}" />
        {% endblock %}
        <link rel="shortcut icon" href="{{ asset('favicon.png') }}" type="image/png">
        <link rel="apple-touch-icon" href="{{ asset('logo-apple-touch.png') }}"/>
        {% block structured_data %}{% endblock %}
        {% block head_extra %}{% endblock %}
        <title>{% block title %}Chanbora Chhun photographe et développeur web fullstack à Marseille{% endblock %}</title>

        {% block stylesheets %}
            {{ encore_entry_link_tags('tailwind_app') }}
        {% endblock %}

        {% set consent = "ShanboraLocalCookie" %} <!-- CONSENT Value -->
    </head>
    <body>

        {#  hidden or flex  #}
        {% set maj_class = "hidden" %}
        {% set maj_date = "Mardi 30/05/2024 de 09h30 à 09h40 - " %}
        {% set maj_text = "Mise à jour du site, utilisation non recommandée." %}

{#        <div id="cookies" class="fixed bottom-4 left-4 z-30" data-consent="{{ consent }}"></div>#}

        <div class="h-full">
            {# --------------- BODY ---------------- #}
            {% block body %}{% endblock %}
        </div>

        <div id="flashes" data-flashes="{{ app.flashes | json_encode }}" class="fixed z-50 top-4 right-4 flex flex-col gap-4"></div>

        {% block javascripts %}
            {{ encore_entry_script_tags('tailwind_app') }}
        {% endblock %}
    </body>
</html>
